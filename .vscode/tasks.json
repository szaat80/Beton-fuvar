{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Beton fuvar: Vite fejlesztői szerver",
            "type": "shell",
            "command": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
            "options": {
                "cwd": "${workspaceFolder}/v70-profi"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Local:.*"
                }
            }
        }
    ]
}
