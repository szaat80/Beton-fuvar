{
  "name": "beton-kdt-v70-profi",
  "version": "70.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "desktop:exe": "vite build --base=./ && electron-builder --win nsis --config.electronDist=./node_modules/electron/dist"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "hu.szaboattila.kdt307",
    "productName": "Beton fuvar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beton fuvar"
    }
  }
}
