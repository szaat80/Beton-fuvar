{
  "name": "beton-kdt-v70-profi",
  "version": "71.0.6",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:copy": "npx cap copy android",
    "cap:sync": "node scripts/patch-capacitor-cli.cjs && npx cap sync android",
    "android:apk": "vite build --base=./ && node scripts/patch-capacitor-cli.cjs && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "desktop:exe": "vite build --base=./ && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "hu.szaboattila.kdt307",
    "productName": "Beton fuvar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beton fuvar"
    }
  }
}
